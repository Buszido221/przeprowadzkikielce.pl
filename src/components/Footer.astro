---
import { site } from '../data/site';
import { brandNavigation, businessNavigation, serviceNavigation } from '../data/routes';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-section">
        <p class="footer-section__title">Kontakt</p>
        <div class="footer-section__list">
          <div class="footer-contact-item">
            <span class="footer-contact-label">Tel.</span>
            <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-label">SMS</span>
            <a href={`sms:${site.phoneRaw}`}>{site.phone}</a>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-label">E-mail</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
        <div style="margin-top: var(--space-4);">
          <p>{site.address.full}</p>
        </div>
        <div class="footer-hours">
          <p>Pn–Pt: {site.hours.weekdays}</p>
          <p>Sob: {site.hours.saturday}</p>
        </div>
        <p class="footer-note">{site.hours.note}</p>
      </div>

      <div class="footer-section">
        <p class="footer-section__title">Usługi</p>
        <ul class="footer-section__list">
          {serviceNavigation.map((link) => (
            <li><a href={link.slug}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-section">
        <p class="footer-section__title">Dla firm</p>
        <ul class="footer-section__list">
          {businessNavigation.map((link) => (
            <li><a href={link.slug}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-section">
        <p class="footer-section__title">WHM</p>
        <ul class="footer-section__list">
          {brandNavigation.map((link) => (
            <li><a href={link.slug}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-section footer-section--documents">
        <p class="footer-section__title">Dokumenty</p>
        <ul class="footer-section__list">
          <li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li>
          <li><a href="/kontakt/">Kontakt i formularz</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
    <p><a href="#" id="cookie-settings-link" onclick="if(window._whm_open_consent){window._whm_open_consent();}return false;">Ustawienia cookies</a></p>
      <p>{site.legalName} &middot; NIP: {site.nip}</p>
    </div>
  </div>
</footer>
