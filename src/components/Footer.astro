---
import { site } from '../data/site';
import { brandNavigation, businessNavigation, serviceNavigation } from '../data/routes';
import { isProduction } from '../lib/environment';

const gtmId = import.meta.env.PUBLIC_GTM_ID || '';
const validGtm = /^GTM-[A-Z0-9]+$/i.test(gtmId);
const showCookieLink = isProduction && validGtm;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-section">
        <p class="footer-section__title">Kontakt</p>
        <div class="footer-section__list">
          <div class="footer-contact-item">
            <span class="footer-contact-label">Tel.</span>
            <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-label">SMS</span>
            <a href={`sms:${site.phoneRaw}`}>{site.phone}</a>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-label">E-mail</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
        <div style="margin-top: var(--space-4);">
          <p>{site.address.full}</p>
        </div>
        <div class="footer-hours">
          <p>Pn–Pt: {site.hours.weekdays}</p>
          <p>Sob: {site.hours.saturday}</p>
        </div>
        <p class="footer-note">{site.hours.note}</p>
      </div>

      <div class="footer-section">
        <p class="footer-section__title">Usługi</p>
        <ul class="footer-section__list">
          {serviceNavigation.map((link) => (
            <li><a href={link.slug}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-section">
        <p class="footer-section__title">Dla firm</p>
        <ul class="footer-section__list">
          {businessNavigation.map((link) => (
            <li><a href={link.slug}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-section">
        <p class="footer-section__title">Poznaj WHM</p>
        <ul class="footer-section__list">
          {brandNavigation.map((link) => (
            <li><a href={link.slug}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-section footer-section--documents">
        <p class="footer-section__title">Dokumenty</p>
        <ul class="footer-section__list">
          <li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li>
          <li><a href="/kontakt/">Kontakt i formularz</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      {showCookieLink && (
        <p><button type="button" id="cookie-settings-link" class="footer-cookie-btn">Ustawienia cookies</button></p>
      )}
      <p>{site.legalName} &middot; NIP: {site.nip}</p>
    </div>
  </div>
</footer>

{showCookieLink && (
  <script>
    document.getElementById('cookie-settings-link')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('whm:open-cookie-settings'));
    });
  </script>
)}

<style>
  .footer-cookie-btn {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer-cookie-btn:hover {
    color: var(--color-red, #c0392b);
  }
  .footer-cookie-btn:focus-visible {
    outline: 2px solid var(--color-red, #c0392b);
    outline-offset: 2px;
  }
</style>
