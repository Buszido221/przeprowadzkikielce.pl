---
import { site } from '../../data/site';
import { consentText } from '../../data/services';

export interface Props {
  formId: string;
  serviceType: string;
  variant?: 'przeprowadzka' | 'firma' | 'pianino' | 'specjalistyczny' | 'gabarytowy' | 'lodowka' | 'agd' | 'pakowanie' | 'utylizacja' | 'meble';
  presentation?: 'page' | 'landing';
  context?: 'consumer' | 'business';
  heading?: string;
  intro?: string;
  formLocation?: string;
  placeholder?: string;
  submitLabel?: string;
}

const {
  formId,
  serviceType,
  variant = 'przeprowadzka',
  presentation = 'landing',
  context = 'consumer',
  heading = 'Opowiedz nam, czego potrzebujesz',
  intro = 'Zostaw telefon lub e-mail i krótko opisz zlecenie. Wrócimy z pytaniami potrzebnymi do przygotowania wyceny.',
  formLocation = '',
  placeholder = '',
  submitLabel = 'Wyślij zapytanie',
} = Astro.props;

const isBusiness = context === 'business' || variant === 'firma';

const emailjsServiceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID ?? '';
const emailjsTemplateId = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID ?? '';
const emailjsPublicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY ?? '';
const emailjsConfigured = Boolean(emailjsServiceId && emailjsTemplateId && emailjsPublicKey);

const siteEnv = import.meta.env.PUBLIC_SITE_ENV === 'production' ? 'production' : 'staging';
---

<div class={`lead-form lead-form--${presentation}`} data-form-id={formId}>
  <div class="lead-form__header">
    {heading && <h3 class="lead-form__heading">{heading}</h3>}
    <p class="lead-form__intro">{intro}</p>
  </div>

  <form data-phone={site.phone} class="lead-form__form" id={formId} autocomplete="on" novalidate data-service-type={serviceType} data-variant={variant} data-context={isBusiness ? 'business' : 'consumer'} data-location={formLocation}>
    <div class="lead-form__field">
      <label class="lead-form__label lead-form__label--required" for={`${formId}_name`}>Imię i nazwisko</label>
      <input class="lead-form__input" type="text" id={`${formId}_name`} name="customer_name" required autocomplete="name" />
      <span class="lead-form__error" data-error-for="customer_name"></span>
    </div>

    {isBusiness && (
      <div class="lead-form__field">
        <label class="lead-form__label" for={`${formId}_company`}>Firma lub instytucja</label>
        <input class="lead-form__input" type="text" id={`${formId}_company`} name="company" autocomplete="organization" />
      </div>
    )}

    <div class="lead-form__row">
      <div class="lead-form__field">
        <label class="lead-form__label" for={`${formId}_phone`}>Numer telefonu</label>
        <input class="lead-form__input" type="tel" id={`${formId}_phone`} name="phone" autocomplete="tel" inputmode="tel" placeholder="np. 600 123 456" />
        <span class="lead-form__error" data-error-for="phone"></span>
      </div>
      <div class="lead-form__field">
        <label class="lead-form__label" for={`${formId}_email`}>Adres e-mail</label>
        <input class="lead-form__input" type="email" id={`${formId}_email`} name="email" autocomplete="email" placeholder="np. jan.kowalski@email.pl" />
        <span class="lead-form__error" data-error-for="email"></span>
      </div>
    </div>
    <p class="lead-form__hint" id={`${formId}_contact_hint`}>Podaj telefon albo e-mail — wystarczy jeden kanał kontaktu.</p>

    <div class="lead-form__field">
      <label class="lead-form__label lead-form__label--required" for={`${formId}_message`}>W czym możemy pomóc?</label>
      <textarea class="lead-form__textarea" id={`${formId}_message`} name="message" rows="4" required placeholder={placeholder || 'Opisz krótko, czego potrzebujesz'}></textarea>
      <span class="lead-form__error" data-error-for="message"></span>
    </div>

    <p class="lead-form__photos-note">Zdjęcia możesz dosłać po zgłoszeniu SMS-em lub e-mailem.</p>

    <label class="lead-form__consent">
      <input type="checkbox" name="privacy_consent" required />
      <span>{consentText} <a href="/polityka-prywatnosci/" target="_blank" rel="noopener noreferrer">Polityka prywatności</a></span>
    </label>
    <span class="lead-form__error" data-error-for="privacy_consent"></span>

    <button type="submit" class="btn btn--primary btn--lg btn--block lead-form__submit" data-label={submitLabel}>{submitLabel}</button>

    <p class="lead-form__response-time">Jeżeli nie możemy odpowiedzieć od razu, wracamy z kontaktem zwykle w ciągu 1–2 godzin w godzinach pracy. Wiadomości wysłane wieczorem obsługujemy rano.</p>

    <input type="hidden" name="service_type" value={serviceType} />
    <input type="hidden" name="form_context" value={isBusiness ? 'B2B' : 'B2C'} />
    <input type="hidden" name="page_url" value="" />
    <input type="hidden" name="page_title" value="" />
    <input type="hidden" name="landing_slug" value="" />
    <input type="hidden" name="form_location" value={formLocation} />
    <input type="hidden" name="submitted_at" value="" />
    <input type="hidden" name="submitted_at_readable" value="" />
    <input type="hidden" name="lead_id" value="" />
    <input type="hidden" name="site_env" value={siteEnv} />
    <input type="hidden" name="referrer" value="" />
    <input type="hidden" name="ft_utm_source" value="" />
    <input type="hidden" name="ft_utm_medium" value="" />
    <input type="hidden" name="ft_utm_campaign" value="" />
    <input type="hidden" name="ft_utm_term" value="" />
    <input type="hidden" name="ft_utm_content" value="" />
    <input type="hidden" name="ft_gclid" value="" />
    <input type="hidden" name="ft_gbraid" value="" />
    <input type="hidden" name="ft_wbraid" value="" />
    <input type="hidden" name="ft_fbclid" value="" />
    <input type="hidden" name="lt_utm_source" value="" />
    <input type="hidden" name="lt_utm_medium" value="" />
    <input type="hidden" name="lt_utm_campaign" value="" />
    <input type="hidden" name="lt_utm_term" value="" />
    <input type="hidden" name="lt_utm_content" value="" />
    <input type="hidden" name="lt_gclid" value="" />
    <input type="hidden" name="lt_gbraid" value="" />
    <input type="hidden" name="lt_wbraid" value="" />
    <input type="hidden" name="lt_fbclid" value="" />
    <input type="hidden" name="ft_campaignid" value="" />
    <input type="hidden" name="ft_adgroupid" value="" />
    <input type="hidden" name="ft_creative" value="" />
    <input type="hidden" name="ft_device" value="" />
    <input type="hidden" name="ft_network" value="" />
    <input type="hidden" name="ft_matchtype" value="" />
    <input type="hidden" name="ft_keyword" value="" />
    <input type="hidden" name="lt_campaignid" value="" />
    <input type="hidden" name="lt_adgroupid" value="" />
    <input type="hidden" name="lt_creative" value="" />
    <input type="hidden" name="lt_device" value="" />
    <input type="hidden" name="lt_network" value="" />
    <input type="hidden" name="lt_matchtype" value="" />
    <input type="hidden" name="lt_keyword" value="" />
    <input type="hidden" name="origin" value="" />
    <input type="hidden" name="destination" value="" />
    <input type="hidden" name="preferred_date" value="" />
    <input type="hidden" name="origin_access" value="" />
    <input type="hidden" name="destination_access" value="" />
    <input type="hidden" name="scope" value="" />
    <input type="hidden" name="item_details" value="" />
    <input type="hidden" name="item_count" value="" />
    <input type="hidden" name="floor" value="" />
    <input type="hidden" name="elevator" value="" />
    <input type="hidden" name="exclusions_consent" value="" />
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="lead-form__honeypot" aria-hidden="true" />

    <div class="lead-form__status" role="status" aria-live="polite" aria-atomic="true"></div>
  </form>

  <div class="lead-form__phone-alt">
    <span>lub zadzwoń:</span>
    <a href={`tel:${site.phoneRaw}`} class="lead-form__phone-link" data-phone-click>{site.phone}</a>
  </div>
</div>

<script>
  import { initLeadForms } from '../../scripts/lead-form';
</script>
