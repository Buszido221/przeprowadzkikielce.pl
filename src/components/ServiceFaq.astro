---
import SectionHeading from './SectionHeading.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  eyebrow?: string;
  items: FaqItem[];
}

const { heading = 'Często zadawane pytania', eyebrow, items } = Astro.props;
---

<section class="service-faq" aria-label={heading}>
  <div class="container">
    <SectionHeading label={eyebrow} title={heading} />
    <div class="service-faq__list">
      {items.map((item, i) => (
        <details class="service-faq__item" open={i === 0}>
          <summary class="service-faq__question">
            <span>{item.question}</span>
            <span class="service-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="service-faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
