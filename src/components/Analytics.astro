---
import { isStaging } from '../lib/environment';

const GTM_ID = import.meta.env.PUBLIC_GTM_ID ?? '';
const hasGtm = GTM_ID && !isStaging;
---

{hasGtm && (
  <noscript>
    <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>
)}

<!-- Cookie Consent Banner (v2) -->
<div id="cookie-consent" class="cookie-consent" role="dialog" aria-label="Zgoda na pliki cookie" aria-hidden="true">
  <div class="cookie-consent__inner">
    <p class="cookie-consent__text">
      Ta strona korzysta z plików cookie. Niezbędne pliki są zawsze aktywne. Możesz dodatkowo zgodzić się na analitykę (Google Analytics) i pomiar reklam (Google Ads, Meta Pixel).
      <a href="/polityka-prywatnosci/">Polityka prywatności</a>
    </p>
    <div class="cookie-consent__actions">
      <button id="cookie-reject" class="cookie-consent__btn cookie-consent__btn--secondary" type="button">Tylko niezbędne</button>
      <button id="cookie-settings" class="cookie-consent__btn cookie-consent__btn--secondary" type="button">Ustawienia</button>
      <button id="cookie-accept" class="cookie-consent__btn cookie-consent__btn--primary" type="button">Akceptuję wszystkie</button>
    </div>
  </div>

  <div id="cookie-consent-settings" class="cookie-consent__settings" hidden>
    <label class="cookie-consent__setting">
      <input type="checkbox" id="consent-analytics" checked disabled />
      <span>Analityka (Google Analytics 4)</span>
    </label>
    <label class="cookie-consent__setting">
      <input type="checkbox" id="consent-ads" />
      <span>Pomiar reklam (Google Ads, Meta Pixel)</span>
    </label>
    <div class="cookie-consent__settings-actions">
      <button id="cookie-settings-save" class="cookie-consent__btn cookie-consent__btn--primary" type="button">Zapisz ustawienia</button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var CONSENT_KEY = 'whm_consent_v2';
  var CONSENT_VERSION = 2;

  function getConsent() {
    try {
      var raw = localStorage.getItem(CONSENT_KEY);
      if (!raw) return null;
      var parsed = JSON.parse(raw);
      if (parsed.version !== CONSENT_VERSION) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function saveConsent(analytics, ads) {
    var data = {
      version: CONSENT_VERSION,
      analytics: analytics,
      ads: ads,
      updated_at: new Date().toISOString()
    };
    localStorage.setItem(CONSENT_KEY, JSON.stringify(data));
    updateConsentMode(analytics, ads);
    return data;
  }

  function updateConsentMode(analytics, ads) {
    if (typeof gtag !== 'function') return;
    gtag('consent', 'update', {
      analytics_storage: analytics ? 'granted' : 'denied',
      ad_storage: ads ? 'granted' : 'denied',
      ad_user_data: ads ? 'granted' : 'denied',
      ad_personalization: ads ? 'granted' : 'denied'
    });
  }

  function showBanner() {
    var banner = document.getElementById('cookie-consent');
    banner.setAttribute('aria-hidden', 'false');
    banner.classList.add('cookie-consent--visible');
  }

  function hideBanner() {
    var banner = document.getElementById('cookie-consent');
    banner.classList.remove('cookie-consent--visible');
    banner.setAttribute('aria-hidden', 'true');
  }

  function showSettings() {
    document.getElementById('cookie-consent-settings').hidden = false;
  }

  function hideSettings() {
    document.getElementById('cookie-consent-settings').hidden = true;
  }

  var consent = getConsent();

  if (!consent) {
    showBanner();
  } else {
    updateConsentMode(consent.analytics, consent.ads);
    if (consent.analytics) initEventTracking();
  }

  document.getElementById('cookie-accept').addEventListener('click', function () {
    saveConsent(true, true);
    hideBanner();
    initEventTracking();
  });

  document.getElementById('cookie-reject').addEventListener('click', function () {
    saveConsent(false, false);
    hideBanner();
  });

  document.getElementById('cookie-settings').addEventListener('click', function () {
    showSettings();
  });

  document.getElementById('cookie-settings-save').addEventListener('click', function () {
    var analytics = document.getElementById('consent-analytics').checked;
    var ads = document.getElementById('consent-ads').checked;
    saveConsent(analytics, ads);
    hideSettings();
    hideBanner();
    if (analytics) initEventTracking();
  });

  window._whm_open_consent = function () {
    var existing = getConsent();
    if (existing) {
      document.getElementById('consent-analytics').checked = existing.analytics;
      document.getElementById('consent-ads').checked = existing.ads;
    }
    showBanner();
    showSettings();
  };

  function initEventTracking() {
    if (window._whm_events_loaded) return;
    window._whm_events_loaded = true;
    trackFormEvents();
    trackInteractionEvents();
  }

  function trackInteractionEvents() {
    document.addEventListener('whm:analytics', function (e) {
      var detail = e.detail || {};
      if (typeof gtag !== 'function') return;

      var interactionEvents = ['phone_click', 'email_click', 'sms_click', 'cta_click', 'whm_shop_click'];
      if (interactionEvents.indexOf(detail.event) === -1) return;

      var isContact = detail.event === 'phone_click' || detail.event === 'email_click' || detail.event === 'sms_click';
      var location = detail.link_location || detail.cta_location || 'content';

      var params = {
        event_category: isContact ? 'kontakt' : 'engagement',
        event_label: location,
        interaction_location: location
      };

      if (isContact) {
        params.link_location = location;
      } else {
        params.cta_location = location;
      }

      if (detail.event === 'whm_shop_click') {
        params.destination_type = 'external_shop';
      }

      if (detail.serviceType) params.service_type = detail.serviceType;
      if (detail.leadContext) params.lead_context = detail.leadContext;

      gtag('event', detail.event, params);
    });
  }

  function trackFormEvents() {
    document.addEventListener('whm:analytics', function (e) {
      var detail = e.detail || {};
      if (typeof gtag !== 'function') return;

      if (detail.event === 'lead_form_start') {
        gtag('event', 'lead_form_start', {
          event_category: 'formularz',
          event_label: detail.serviceType || 'unknown',
          service_type: detail.serviceType || '',
          form_location: detail.formLocation || '',
          lead_context: detail.leadContext || ''
        });
      }

      if (detail.event === 'lead_form_validation_error') {
        gtag('event', 'lead_form_validation_error', {
          event_category: 'formularz',
          event_label: detail.serviceType || 'unknown',
          service_type: detail.serviceType || '',
          form_location: detail.formLocation || '',
          error_type: detail.errorType || 'validation'
        });
      }

      if (detail.event === 'lead_form_submit_error') {
        gtag('event', 'lead_form_submit_error', {
          event_category: 'formularz',
          event_label: detail.serviceType || 'unknown',
          service_type: detail.serviceType || '',
          form_location: detail.formLocation || '',
          error_type: detail.errorType || 'submit'
        });
      }
    });

    document.addEventListener('whm:form_success', function (e) {
      if (typeof gtag !== 'function') return;
      var detail = e.detail || {};
      gtag('event', 'generate_lead', {
        event_category: 'formularz',
        event_label: detail.serviceType || 'unknown',
        form_id: detail.formId || 'unknown',
        service_type: detail.serviceType || '',
        form_location: detail.formLocation || '',
        lead_context: detail.leadContext || '',
        lead_id: detail.leadId || ''
      });
    });
  }
})();
</script>
