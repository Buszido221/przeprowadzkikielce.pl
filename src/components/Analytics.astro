---
import { isProduction } from '../lib/environment';

const gtmId = import.meta.env.PUBLIC_GTM_ID || '';
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
const validGtm = /^GTM-[A-Z0-9]+$/i.test(gtmId);
const validGa = /^G-[A-Z0-9]+$/i.test(gaMeasurementId);
const enabled = isProduction && (validGtm || validGa);
---

{enabled && (
  <div
    id="cookie-consent"
    class="cookie-consent cookie-consent--visible"
    role="dialog"
    aria-label="Ustawienia prywatności"
    aria-modal="false"
  >
    <div class="cookie-consent__inner">
      <div class="cookie-consent__main">
        <p class="cookie-consent__text">
          Ta strona używa plików cookie. Niezbędne są zawsze aktywne. Możesz włączyć analityczne i&nbsp;marketingowe, aby pomóc nam ulepszać stronę i&nbsp;mierzyć skuteczność reklam.
        </p>
        <div class="cookie-consent__actions">
          <button type="button" id="cookie-accept" class="cookie-consent__btn cookie-consent__btn--accept">Akceptuję wszystkie</button>
          <button type="button" id="cookie-reject" class="cookie-consent__btn cookie-consent__btn--reject">Odrzucam wszystkie</button>
          <button type="button" id="cookie-settings-open" class="cookie-consent__btn cookie-consent__btn--settings" aria-expanded="false" aria-controls="cookie-settings-panel">Ustawienia</button>
        </div>
      </div>

      <div id="cookie-settings-panel" class="cookie-consent__settings" hidden>
        <fieldset class="cookie-consent__fieldset">
          <legend class="cookie-consent__legend">Kategorie plików cookie</legend>

          <label class="cookie-consent__category">
            <input type="checkbox" checked disabled />
            <span class="cookie-consent__category-name">Niezbędne</span>
            <span class="cookie-consent__category-desc">Zapewniają prawidłowe działanie strony. Zawsze aktywne.</span>
          </label>

          <label class="cookie-consent__category">
            <input type="checkbox" id="consent-analytics" />
            <span class="cookie-consent__category-name">Analityczne</span>
            <span class="cookie-consent__category-desc">Pomagają zrozumieć, jak odwiedzający korzystają ze strony (Google Analytics&nbsp;4).</span>
          </label>

          <label class="cookie-consent__category">
            <input type="checkbox" id="consent-marketing" />
            <span class="cookie-consent__category-name">Marketingowe</span>
            <span class="cookie-consent__category-desc">Służą do mierzenia skuteczności reklam (Google Ads, Meta Pixel).</span>
          </label>
        </fieldset>

        <div class="cookie-consent__settings-actions">
          <button type="button" id="cookie-save" class="cookie-consent__btn cookie-consent__btn--accept">Zapisz wybrane</button>
          <button type="button" id="cookie-settings-close" class="cookie-consent__btn cookie-consent__btn--settings">Zamknij</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import {
      getSavedConsent,
      hasDecision,
      applyConsent,
      restoreConsent,
    } from '../lib/consent';

    (function initConsentBanner() {
      const gtmId = (window as any).__WHM_GTM_ID as string | undefined;
      const gaMeasurementId = (window as any).__WHM_GA_ID as string | undefined;
      if (!gtmId && !gaMeasurementId) return;

      const banner = document.getElementById('cookie-consent')!;
      const panel = document.getElementById('cookie-settings-panel')!;
      const btnAccept = document.getElementById('cookie-accept')!;
      const btnReject = document.getElementById('cookie-reject')!;
      const btnOpen = document.getElementById('cookie-settings-open')!;
      const btnSave = document.getElementById('cookie-save')!;
      const btnClose = document.getElementById('cookie-settings-close')!;
      const chkAnalytics = document.getElementById('consent-analytics') as HTMLInputElement;
      const chkMarketing = document.getElementById('consent-marketing') as HTMLInputElement;

      let openedBy: HTMLElement | null = null;

      function hideBanner() {
        banner.classList.remove('cookie-consent--visible');
        banner.setAttribute('aria-hidden', 'true');
      }

      function showBanner() {
        banner.classList.add('cookie-consent--visible');
        banner.removeAttribute('aria-hidden');
      }

      function focusStable() {
        const target = document.getElementById('main-content') || document.body;
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      }

      function openSettings(trigger: HTMLElement | null) {
        openedBy = trigger;
        const saved = getSavedConsent();
        chkAnalytics.checked = saved?.analytics ?? false;
        chkMarketing.checked = saved?.marketing ?? false;
        panel.hidden = false;
        btnOpen.setAttribute('aria-expanded', 'true');
        chkAnalytics.focus();
      }

      function closeSettings() {
        panel.hidden = true;
        btnOpen.setAttribute('aria-expanded', 'false');
        if (openedBy && openedBy.isConnected && openedBy.offsetParent !== null) {
          openedBy.focus();
        } else {
          btnOpen.focus();
        }
        openedBy = null;
      }

      function save(analytics: boolean, marketing: boolean) {
        applyConsent(analytics, marketing, gtmId, gaMeasurementId);
        hideBanner();
        panel.hidden = true;
        btnOpen.setAttribute('aria-expanded', 'false');
        openedBy = null;
        focusStable();
      }

      btnAccept.addEventListener('click', () => save(true, true));
      btnReject.addEventListener('click', () => save(false, false));
      btnOpen.addEventListener('click', () => openSettings(btnOpen));
      btnClose.addEventListener('click', () => closeSettings());
      btnSave.addEventListener('click', () => save(chkAnalytics.checked, chkMarketing.checked));

      panel.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeSettings();
        }
      });

      const saved = getSavedConsent();
      if (hasDecision(saved)) {
        hideBanner();
        restoreConsent(gtmId, gaMeasurementId);
      } else {
        showBanner();
      }

      window.addEventListener('whm:open-cookie-settings', () => {
        const footerBtn = document.getElementById('cookie-settings-link');
        showBanner();
        openSettings(footerBtn);
      });
    })();
  </script>
)}

<style>
  .cookie-consent {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: var(--color-surface-dark, #1a1a1a);
    color: rgba(255, 255, 255, 0.9);
    transform: translateY(100%);
    transition: transform 0.3s ease;
    font-size: var(--text-sm, 0.875rem);
  }
  .cookie-consent--visible {
    transform: translateY(0);
  }
  .cookie-consent[aria-hidden="true"] {
    transform: translateY(100%);
  }
  .cookie-consent__inner {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-4, 1rem) var(--space-5, 1.25rem);
  }
  .cookie-consent__text {
    margin: 0 0 var(--space-3, 0.75rem);
    line-height: 1.5;
  }
  .cookie-consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
  }
  .cookie-consent__btn {
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-sm, 4px);
    background: transparent;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    font-size: var(--text-sm, 0.875rem);
    font-family: inherit;
    line-height: 1.4;
    transition: background 0.15s, border-color 0.15s;
  }
  .cookie-consent__btn:hover {
    border-color: rgba(255, 255, 255, 0.5);
  }
  .cookie-consent__btn:focus-visible {
    outline: 2px solid var(--color-red, #c0392b);
    outline-offset: 2px;
  }
  .cookie-consent__btn--accept {
    background: var(--color-red, #c0392b);
    border-color: var(--color-red, #c0392b);
    color: #fff;
  }
  .cookie-consent__btn--accept:hover {
    background: var(--color-red-dark, #a93226);
    border-color: var(--color-red-dark, #a93226);
  }
  .cookie-consent__btn--reject {
    background: transparent;
  }
  .cookie-consent__settings {
    margin-top: var(--space-4, 1rem);
    padding-top: var(--space-4, 1rem);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .cookie-consent__fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }
  .cookie-consent__legend {
    font-weight: 600;
    margin-bottom: var(--space-3, 0.75rem);
    font-size: var(--text-sm, 0.875rem);
  }
  .cookie-consent__category {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-2, 0.5rem);
    cursor: pointer;
  }
  .cookie-consent__category input {
    margin-top: 3px;
    accent-color: var(--color-red, #c0392b);
  }
  .cookie-consent__category input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .cookie-consent__category-name {
    font-weight: 600;
    min-width: 100px;
  }
  .cookie-consent__category-desc {
    color: rgba(255, 255, 255, 0.65);
  }
  .cookie-consent__settings-actions {
    display: flex;
    gap: var(--space-2, 0.5rem);
    margin-top: var(--space-3, 0.75rem);
  }
</style>
