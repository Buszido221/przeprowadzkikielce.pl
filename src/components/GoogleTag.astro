---
import { isProduction } from '../lib/environment';

const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
const validMeasurementId = /^G-[A-Z0-9]+$/i.test(measurementId);
const enabled = isProduction && validMeasurementId;
---

{enabled && (
  <script is:inline define:vars={{ measurementId }}>
    window.__WHM_GA_ID = measurementId;
  </script>
)}
