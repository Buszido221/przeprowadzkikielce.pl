---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import SafeImage from '../../components/SafeImage.astro';
import { site } from '../../data/site';
import { transportSpecPage as page } from '../../data/services';
import { getSeo } from '../../data/seo';
import { buildSchemaGraph, buildFaqSchema } from '../../lib/schema';

const seo = getSeo('/transport-specjalistyczny/');
const schemaGraph = buildSchemaGraph({ slug: '/transport-specjalistyczny/', breadcrumbs: [{ name: 'Usługi', url: 'https://przeprowadzkikielce.pl/uslugi/' }, { name: 'Transport specjalistyczny' }] });
const faqSchema = buildFaqSchema(page.faq.map((q) => ({ question: q.question, answer: q.answer })));
---

<Layout seo={seo} schemaGraph={schemaGraph} faqSchema={faqSchema}>

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
    ctaLabel={`Zadzwoń: ${site.phone}`}
    ctaHref={`tel:${site.phoneRaw}`}
    ctaSecondaryLabel="Opisz transport"
    ctaSecondaryHref="#formularz"
    note={page.hero.note}
    heroImage={page.hero.image}
  />

  <!-- CATEGORIES -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.categories.eyebrow} title={page.categories.heading} />
      <ul class="simple-list">
        {page.categories.items.map((item) => (
          <li class="simple-list__item">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TWO SERVICES -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.services.eyebrow} title={page.services.heading} />
      <div class="services-grid services-grid--2col">
        {page.services.items.map((item) => (
          <a href={item.href} class="service-card">
            <div class="service-card__media">
              <SafeImage src={item.image} alt={item.alt} loading="lazy" decoding="async" />
            </div>
            <div class="service-card__body">
              <h3 class="service-card__title">{item.title}</h3>
              <p class="service-card__desc">{item.desc}</p>
              <span class="service-card__link">Dowiedz się więcej</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.assessment.eyebrow} title={page.assessment.heading} />
      <ol class="scope-list">
        {page.assessment.items.map((item) => (
          <li class="scope-list__item">{item}</li>
        ))}
      </ol>
    </div>
  </section>

  <!-- EQUIPMENT -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.equipment.eyebrow} title={page.equipment.heading} description={page.equipment.text} />
      <div class="equipment-notice">{page.equipment.notice}</div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.gallery.eyebrow} title={page.gallery.heading} />
      <div class="photo-grid photo-grid--3">
        {page.gallery.items.map((photo) => (
          <div class="photo-grid__item">
            <SafeImage src={photo.src} alt={photo.alt} loading="lazy" decoding="async" displayMode="natural" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.process.eyebrow} title={page.process.heading} />
      <div class="process-steps">
        {page.process.steps.map((step) => (
          <div class="process-step">
            <span class="process-step__number">{step.number}</span>
            <div>
              <p class="process-step__title">{step.title}</p>
              <p class="process-step__desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="formularz" class="form-section" aria-label="Formularz wyceny transportu specjalistycznego">
    <div class="container">
      <SectionHeading title="Opisz przedmiot i warunki dostępu" description="Podaj gabaryty, masę, lokalizacje i utrudnienia. Zdjęcia oraz dokumentację możesz dosłać po zgłoszeniu." />
      <div class="form-section__grid">
        <div class="form-section__phone-card">
          <p class="section-heading__label">Najpierw ocena</p>
          <h3>Zadzwoń i omów zadanie</h3>
          <a href={`tel:${site.phoneRaw}`} data-cta-click data-cta-location="specialist-form">{site.phone}</a>
          <p class="form-section__phone-note">Przy nietypowych zleceniach ustalamy technologię pracy przed potwierdzeniem realizacji.</p>
        </div>
        <LeadForm formId="specialist-service-form" serviceType="Transport specjalistyczny" presentation="page" context="consumer" formLocation="/transport-specjalistyczny/" placeholder="Co mamy przetransportować i jakie są warunki dostępu?" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Najczęstsze pytania" title="Odpowiedzi na pytania o transport specjalistyczny" />
      <div class="faq-list">
        {page.faq.map((item) => (
          <details class="faq-item">
            <summary class="faq-item__question">{item.question}</summary>
            <div class="faq-item__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">{page.finalCta.heading}</h2>
        <p class="final-cta__text">{page.finalCta.text}</p>
        <div class="final-cta__actions">
          <a href="/kontakt/#formularz" class="btn btn--primary btn--lg" data-cta-click data-cta-location="specialist-final">{page.finalCta.ctaLabel}</a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn--secondary btn--lg" data-cta-click data-cta-location="specialist-final">Zadzwoń: 720 719 022</a>
        </div>
        <p class="final-cta__hours">Pn–Pt: {site.hours.weekdays} &middot; Sob: {site.hours.saturday}</p>
      </div>
    </div>
  </section>
  <MobileStickyCta />
</Layout>
