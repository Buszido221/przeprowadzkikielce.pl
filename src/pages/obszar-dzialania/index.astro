---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import SafeImage from '../../components/SafeImage.astro';
import { site } from '../../data/site';
import { getRoute } from '../../data/routes';
import { getSeo } from '../../data/seo';
import { buildSchemaGraph } from '../../lib/schema';

const route = getRoute('/obszar-dzialania/');
const seo = getSeo('/obszar-dzialania/');
const schemaGraph = buildSchemaGraph({ slug: '/obszar-dzialania/', breadcrumbs: [{ name: 'Obszar działania' }] });
---

<Layout seo={seo} schemaGraph={schemaGraph}>
  <ServiceHero eyebrow="Obszar działania" heading="Gdzie działamy?" lead="Kielce i okolice to nasz codzienny teren. Realizujemy też przeprowadzki na terenie całej Polski i za granicę." breadcrumbs={[{ label: route.name }]} heroImage="/images/kielce-moving/przeprowadzki-kielce-6.webp" heroAlt="Samochód WHM w trasie podczas realizacji przeprowadzki" secondaryCtaLabel="Opisz trasę" secondaryCtaHref="/kontakt/#formularz" />
  <section class="section section--alt"><div class="container"><SectionHeading label="Zasięg" title="Trzy skale tej samej odpowiedzialnej usługi" description="Niezależnie od odległości, zasób, zespół i sprzęt dobieramy do konkretnej realizacji. Przy większych projektach możliwe są bezpłatne oględziny." /><div class="items-grid"><article class="items-grid__item"><h2 class="items-grid__title">Kielce i okolice</h2><p class="items-grid__desc">Lokalne zlecenia obejmują przeprowadzki mieszkań i domów, transport pojedynczych mebli, relokacje firm i instytucji oraz transport specjalistyczny. Znamy miasto, osiedla i charakterystyczne budynki.</p><div class="section-cta"><a href="/przeprowadzki/" class="arrow-link">Przeprowadzki w Kielcach</a></div></article><article class="items-grid__item"><h2 class="items-grid__title">Województwo świętokrzyskie</h2><p class="items-grid__desc">Obsługujemy cały region - od mniejszych miejscowości po większe ośrodki. Realizujemy relokacje między miejscowościami, transport gabarytowy i przeprowadzki instytucjonalne.</p><div class="section-cta"><a href="/uslugi/" class="arrow-link">Zobacz wszystkie usługi</a></div></article><article class="items-grid__item"><h2 class="items-grid__title">Cała Polska</h2><p class="items-grid__desc">Trasy krajowe planujemy według zakresu mienia, dostępu do budynków, terminu i rodzaju ładunku. Odległość wpływa na wycenę - opisz nam swoją trasę.</p><div class="section-cta"><a href="/kontakt/#formularz" class="arrow-link">Opisz trasę</a></div></article></div></div></section>
  <section class="section"><div class="container"><div class="split-section split-section--reverse"><div class="split-section__content"><SectionHeading label="Punkt startowy" title="Zaplecze w Masłowie Pierwszym" description={`Adres operacyjny WHM to ${site.address.full}. Znajdują się tu biuro, sklep i magazyn; wizytę zawsze umawiamy wcześniej telefonicznie.`} /><div class="section-cta"><a class="arrow-link" href="/kontakt/">Dane kontaktowe i godziny</a></div></div><div class="split-section__media"><SafeImage src="/images/hero/hero-4.webp" alt="Samochód WHM przy realizacji transportu" loading="lazy" decoding="async" class="section-img" displayMode="section" /></div></div></div></section>
  <section class="final-cta"><div class="container"><div class="final-cta__inner"><h2 class="final-cta__heading">Sprawdź możliwość realizacji Twojej trasy</h2><p class="final-cta__text">Podaj miejsca odbioru i dostawy, termin oraz krótki zakres.</p><div class="final-cta__actions"><a href={`tel:${site.phoneRaw}`} class="btn btn--primary btn--lg" data-cta-click data-cta-location="area-final">Zadzwoń: {site.phone}</a><a href="/kontakt/#formularz" class="btn btn--secondary btn--lg" data-cta-click data-cta-location="area-final">Opisz zlecenie</a></div></div></div></section>
  <MobileStickyCta formHref="/kontakt/#formularz" />
</Layout>
