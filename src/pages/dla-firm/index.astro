---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import SafeImage from '../../components/SafeImage.astro';
import { site } from '../../data/site';
import { getRoute } from '../../data/routes';
import { getSeo } from '../../data/seo';
import { buildSchemaGraph } from '../../lib/schema';

const route = getRoute('/dla-firm/');
const services = [
  { title: 'Przeprowadzki biur i instytucji', text: 'Pakowanie dokumentów, demontaż mebli biurowych, transport IT, ustawienie w nowej lokalizacji.' },
  { title: 'Opróżnianie lokali', text: 'Wywóz starych mebli, sprzętu, kartonów. Utylizacja lub przekazanie do ponownego użytku.' },
  { title: 'Prace porządkowe', text: 'Sprzątanie po remoncie, po przeprowadzce lub przed przekazaniem lokalu.' },
  { title: 'Zabezpieczenie mienia', text: 'Foliowanie, kartony, palety - jeśli mienie czeka na transport lub przechowanie.' },
];
---

<Layout seo={getSeo('/dla-firm/')} schemaGraph={buildSchemaGraph({ slug: '/dla-firm/', breadcrumbs: [{ name: 'Dla firm' }] })}>
  <ServiceHero
    eyebrow="WHM dla biznesu i instytucji"
    heading="Obsługa firm i instytucji"
    lead="Przeprowadzki biur, archiwów, magazynów, hal. Utylizacja wyposażenia, prace porządkowe po remoncie, zabezpieczenie mienia na czas zmiany lokalu."
    breadcrumbs={[{ label: route.name }]}
    heroImage="/images/office-moving/przeprowadzki-biura-1.webp"
    heroAlt="Zabezpieczone wyposażenie biurowe przygotowane przez zespół WHM"
    secondaryCtaLabel="Zapytaj o wycenę"
    secondaryCtaHref="#kontakt-b2b"
  />

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Usługi dla biznesu" title="Co robimy dla firm?" description="Łączymy kilka usług w jedno zlecenie - dzięki temu nie musisz koordynować osobno transportu, ekipy pakującej i firmy sprzątającej." />
      <div class="services-grid services-grid--2col">
        {services.map((item) => (
          <article class="service-card"><div class="service-card__body"><h2 class="service-card__title">{item.title}</h2><p class="service-card__desc">{item.text}</p></div></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-section split-section--reverse">
        <div class="split-section__content">
          <SectionHeading label="Dowód w praktyce" title="Relokacja instytucji bez przerwy w działaniu" description="W realizacji dla Prokuratury Kielce-Wschód i Kielce-Zachód zakres objął pięć kondygnacji oraz piwnicę z archiwami, wyposażenie ponad stu pracowników i dziesiątki szaf i komputerów. Około 2 miesięcy prac. Organizacja pozwoliła utrzymać ciągłość działania instytucji." />
          <div class="section-cta"><a class="arrow-link" href="/realizacje/">Przejdź do studiów przypadków</a></div>
        </div>
        <div class="split-section__media"><SafeImage src="/images/institution-moving/przeprowadzki-instytucji-5.webp" alt="Zespół WHM podczas relokacji instytucjonalnej" loading="lazy" decoding="async" class="section-img" displayMode="section" /></div>
      </div>
    </div>
  </section>

  <section id="kontakt-b2b" class="form-section" aria-label="Kontakt B2B">
    <div class="container">
      <SectionHeading title="Opisz potrzeby swojej firmy" description="Zakres, termin, lokalizacja - na tej podstawie przygotujemy wycenę." />
      <div class="form-section__grid">
        <div class="form-section__phone-card"><p class="section-heading__label">Kontakt dla firm</p><h3>Porozmawiaj z zespołem WHM</h3><a href={`tel:${site.phoneRaw}`} data-cta-click data-cta-location="business-hub-form">{site.phone}</a><p class="form-section__phone-note">Zadzwoń - omówimy zakres i zaproponujemy rozwiązanie.</p></div>
        <LeadForm formId="business-hub-form" serviceType="Zapytanie B2B" variant="firma" presentation="page" context="business" formLocation="/dla-firm/" placeholder="Czego dotyczy zlecenie? Jaka jest skala? Na kiedy planujesz?" submitLabel="Wyślij zapytanie" />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container" style="text-align:center;">
      <SectionHeading title="Wolisz porozmawiać?" description="Zadzwoń - omówimy zakres i zaproponujemy rozwiązanie." />
      <a class="btn btn--primary" href="#kontakt-b2b">Zapytaj o wycenę</a>
    </div>
  </section>

  <MobileStickyCta formHref="#kontakt-b2b" />
</Layout>
