---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import SafeImage from '../../components/SafeImage.astro';
import { site } from '../../data/site';
import { pakowanePage as page } from '../../data/services';
import { getSeo } from '../../data/seo';
import { buildSchemaGraph, buildFaqSchema } from '../../lib/schema';

const seo = getSeo('/pakowanie-i-zabezpieczanie/');
const schemaGraph = buildSchemaGraph({ slug: '/pakowanie-i-zabezpieczanie/', breadcrumbs: [{ name: 'Usługi', url: 'https://przeprowadzkikielce.pl/uslugi/' }, { name: 'Pakowanie i zabezpieczanie' }] });
const faqSchema = buildFaqSchema(page.faq.map((q) => ({ question: q.question, answer: q.answer })));
---

<Layout seo={seo} schemaGraph={schemaGraph} faqSchema={faqSchema}>

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
    ctaLabel={`Zadzwoń: ${site.phone}`}
    ctaHref={`tel:${site.phoneRaw}`}
    ctaSecondaryLabel="Opisz zlecenie"
    ctaSecondaryHref="#formularz"
  />

  <!-- WHAT WE PACK -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.whatWePack.eyebrow} title={page.whatWePack.heading} />
      <div class="items-grid">
        {page.whatWePack.items.map((item) => (
          <div class="items-grid__item">
            <p class="items-grid__title">{item.title}</p>
            <p class="items-grid__desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MATERIALS -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content">
          <SectionHeading label={page.materials.eyebrow} title={page.materials.heading} description={page.materials.text} />
          <div class="materials-list">
            {page.materials.items.map((item) => (
              <div class="materials-list__item">
                <span class="materials-list__name">{item.name}</span>
                <span class="materials-list__desc">{item.desc}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="split-section__media">
          <SafeImage src={page.materials.image} alt={page.materials.imageAlt} loading="lazy" decoding="async" class="section-img" displayMode="section" />
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section">
    <div class="container">
      <div class="split-section split-section--reverse">
        <div class="split-section__content">
          <SectionHeading label={page.process.eyebrow} title={page.process.heading} />
          <div class="standard-steps">
            {page.process.steps.map((step) => (
              <div class="standard-step">
                <span class="standard-step__number">{step.number}</span>
                <div>
                  <p class="standard-step__title">{step.title}</p>
                  <p class="standard-step__desc">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="split-section__media">
          <SafeImage src={page.process.image} alt={page.process.imageAlt} loading="lazy" decoding="async" class="section-img" displayMode="section" />
        </div>
      </div>
    </div>
  </section>

  <!-- SELF VS WHM -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content">
          <SectionHeading label={page.selfVsWhm.eyebrow} title={page.selfVsWhm.heading} />
          <div class="options-grid">
            {page.selfVsWhm.options.map((opt) => (
              <div class="option-card">
                <p class="option-card__title">{opt.title}</p>
                <ul class="option-card__list">
                  {opt.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
        <div class="split-section__media">
          <SafeImage src={page.selfVsWhm.image} alt={page.selfVsWhm.imageAlt} loading="lazy" decoding="async" class="section-img" displayMode="section" />
        </div>
      </div>
    </div>
  </section>

  <!-- WHM SHOP -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.shop.eyebrow} title={page.shop.heading} />
      <div class="shop-callout">
        <div class="shop-callout__media">
          <SafeImage src={page.shop.image} alt={page.shop.imageAlt} loading="lazy" decoding="async" />
        </div>
        <div class="shop-callout__body">
          <p>{page.shop.text}</p>
          <div class="section-cta">
            <a href={page.shop.cta.href} class="btn btn--primary" target="_blank" rel="noopener noreferrer" data-cta-click data-cta-location="packing-shop">{page.shop.cta.label}</a>
            <p class="external-link-note">Link otwiera zewnętrzny sklep whmshop.pl</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="formularz" class="form-section" aria-label="Formularz wyceny pakowania">
    <div class="container">
      <SectionHeading title="Opisz zakres pakowania" description="Podaj skalę zlecenia, termin i rodzaj mienia. Wystarczy telefon albo e-mail." />
      <div class="form-section__grid">
        <div class="form-section__phone-card">
          <p class="section-heading__label">Najszybciej</p>
          <h3>Zadzwoń i omów zakres</h3>
          <a href={`tel:${site.phoneRaw}`} data-cta-click data-cta-location="packing-form">{site.phone}</a>
          <p class="form-section__phone-note">Możemy zaplanować pełne pakowanie albo pomoc tylko przy wybranych elementach.</p>
        </div>
        <LeadForm formId="packing-service-form" serviceType="Pakowanie i zabezpieczanie" presentation="page" context="consumer" formLocation="/pakowanie-i-zabezpieczanie/" placeholder="Co mamy spakować lub zabezpieczyć?" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Najczęstsze pytania" title="Pytania o pakowanie i zabezpieczanie" />
      <div class="faq-list">
        {page.faq.map((item) => (
          <details class="faq-item">
            <summary class="faq-item__question">{item.question}</summary>
            <div class="faq-item__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">Potrzebujesz pomocy z pakowaniem?</h2>
        <p class="final-cta__text">Opisz mienie, zakres pakowania i termin. Przygotujemy propozycję materiałów i pracy zespołu.</p>
        <div class="final-cta__actions">
          <a href="/kontakt/#formularz" class="btn btn--primary btn--lg" data-cta-click data-cta-location="packing-final">Zapytaj o pakowanie</a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn--secondary btn--lg" data-cta-click data-cta-location="packing-final">Zadzwoń: {site.phone}</a>
        </div>
        <p class="final-cta__hours">Pn–Pt: {site.hours.weekdays} &middot; Sob: {site.hours.saturday}</p>
      </div>
    </div>
  </section>
  <MobileStickyCta />
</Layout>
