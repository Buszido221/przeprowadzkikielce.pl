---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import TrustBar from '../../components/TrustBar.astro';
import StandardWhm from '../../components/StandardWhm.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import ServiceGallery from '../../components/ServiceGallery.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import FinalCta from '../../components/FinalCta.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import { site } from '../../data/site';
import { testimonials } from '../../data/home';
import { getSeo } from '../../data/seo';
import { buildSchemaGraph, buildFaqSchema } from '../../lib/schema';

const seo = getSeo('/przeprowadzki/');
const schemaGraph = buildSchemaGraph({ slug: '/przeprowadzki/', breadcrumbs: [{ name: 'Przeprowadzki' }] });

const breadcrumbs = [{ label: 'Przeprowadzki' }];

const selectedTestimonials = testimonials.filter((t) =>
  t.author === 'Zbigniew Pakuła' ||
  t.author === 'Marzena' ||
  t.author === 'Wiola' ||
  t.author === 'Lidia Gurba'
);

const faqItems = [
  {
    question: 'Jak szybko mogę się przeprowadzić?',
    answer: 'Termin zależy od kalendarza ekip i zakresu prac. Przy mniejszych przeprowadzkach często możemy działać w ciągu kilku dni. Przy większych - ustalamy harmonogram tak, żeby nie było pośpiechu.',
  },
  {
    question: 'Czy mogę spakować część rzeczy samodzielnie?',
    answer: 'Tak. Możesz przygotować kartony z drobnymi rzeczami, a nam zostawić meble, sprzęt i przedmioty wymagające specjalnego zabezpieczenia.',
  },
  {
    question: 'Czy ekipa wniesie rzeczy na piętro bez windy?',
    answer: 'Tak. Wnoszenie na piętra jest częścią usługi - niezależnie od tego, czy w budynku jest winda.',
  },
  {
    question: 'Co z rzeczami, których nie chcę zabierać?',
    answer: 'Możemy je zutylizować lub przekazać do ponownego użytku w ramach usługi opróżniania. Wystarczy wskazać, co ma zostać usunięte.',
  },
  {
    question: 'Przeprowadzam się poza Kielce - czy to możliwe?',
    answer: 'Tak. Realizujemy przeprowadzki na terenie całej Polski i za granicę. Dłuższy dystans wpływa na cenę, ale nie na jakość zabezpieczenia.',
  },
  {
    question: 'Co jeśli coś się uszkodzi?',
    answer: 'Każde zlecenie jest ubezpieczone. W razie szkody zgłoś ją od razu ekipie - Loss Adjuster ustali przyczynę, a my pokryjemy naprawę lub wypłacimy odszkodowanie.',
  },
];
const faqSchema = buildFaqSchema(faqItems);
---

<Layout seo={seo} schemaGraph={schemaGraph} faqSchema={faqSchema}>

  <ServiceHero
    eyebrow="Przeprowadzki w Kielcach i całej Polsce"
    heading="Przeprowadzka pod klucz - od pakowania po ustawienie mebli"
    lead="Powiedz nam, co i dokąd ma trafić. My dobierzemy ekipę, transport i materiały - a na koniec ustawimy wszystko tam, gdzie chcesz."
    breadcrumbs={breadcrumbs}
    heroImage="/images/home-moving/przeprowadzki-domow-kielce-3.webp"
    heroAlt="Zabezpieczone wyposażenie przygotowane do transportu przy domu"
    secondaryCtaLabel="Zapytaj o wycenę"
    secondaryCtaHref="#formularz"
    note="Kielce • woj. świętokrzyskie • przeprowadzki ogólnopolskie"
  />

  <TrustBar facts={[
    { title: 'Ochrona ubezpieczeniowa do 1 mln zł', desc: 'Zastosowanie i warunki ochrony potwierdzamy dla konkretnego zlecenia.' },
    { title: 'Bezpłatne oględziny większych zleceń', desc: 'Przy większych lub złożonych przeprowadzkach przyjeżdżamy, by ocenić zakres na miejscu.' },
    { title: 'Profesjonalne zabezpieczenia w standardzie', desc: 'Koce, gumy, dedykowane pokrowce i pasy - nie jako opcja, ale jako podstawa.' },
  ]} />

  <section class="how-it-works-section" aria-label="Na czym polega przeprowadzka z WHM?">
    <div class="container">
      <SectionHeading title="Na czym polega przeprowadzka z WHM?" />
      <p class="how-it-works-section__intro">Nie musisz sam pakować, szukać transportu ani organizować ekipy. Opisz nam zakres - ile pomieszczeń, jakie meble, czy są rzeczy wymagające szczególnej ochrony - a my przygotujemy plan i wycenę.</p>
      <div class="how-it-works-section__grid">
        <div class="how-it-works-section__card">
          <h3 class="how-it-works-section__card-title">Oględziny i wycena</h3>
          <p>Przyjeżdżamy lub rozmawiamy telefonicznie. Oceniamy kubaturę, ustalamy zakres i termin.</p>
        </div>
        <div class="how-it-works-section__card">
          <h3 class="how-it-works-section__card-title">Zabezpieczenie i pakowanie</h3>
          <p>Meble zabezpieczamy kocami i dedykowanymi pokrowcami, a w samochodzie stabilizujemy pasami.</p>
        </div>
        <div class="how-it-works-section__card">
          <h3 class="how-it-works-section__card-title">Transport i wnoszenie</h3>
          <p>Dobieramy auto do kubatury. Wnosimy, wjeżdżamy windą, wchodzimy po schodach. Warunki dostępu i zakres wnoszenia uwzględniamy w wycenie.</p>
        </div>
        <div class="how-it-works-section__card">
          <h3 class="how-it-works-section__card-title">Ustawienie na miejscu</h3>
          <p>Meble trafiają tam, gdzie wskażesz. Sprawdzamy, czy niczego nie brakuje i czy wszystko jest w porządku.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="perspective-section" aria-label="Skąd wiadomo, że to się opłaca?">
    <div class="container">
      <SectionHeading title="Skąd wiadomo, że to się opłaca?" />
      <div class="perspective-section__content">
        <div class="perspective-section__item">
          <h3>Jedno zlecenie zamiast czterech</h3>
          <p>Zamiast osobno szukać ekipy, transportu, materiałów do pakowania i ubezpieczenia - masz jedną umowę i jedną osobę do kontaktu.</p>
        </div>
        <div class="perspective-section__item">
          <h3>Mniej ryzyka niż na własną rękę</h3>
          <p>Zabezpieczenia i przygotowanie zespołu ograniczają ryzyko uszkodzeń.</p>
        </div>
        <div class="perspective-section__item">
          <h3>Realny czas, realny koszt</h3>
          <p>Podajemy stawkę przed startem - nie po zakończeniu. Wiesz, ile zapłacisz, zanim podejmiesz decyzję.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pricing-section" aria-label="Ile to kosztuje?">
    <div class="container">
      <SectionHeading title="Ile to kosztuje?" />
      <p class="pricing-section__text">Cena zależy od tego, co i dokąd przewozisz, ile jest do zapakowania i czy potrzebne są dodatkowe usługi (np. podnośnik meblowy, magazynowanie). Dlatego zamiast podawać widełki, które mogą być nietrafione - wolimy poznać szczegóły i podać konkretną kwotę.</p>
      <div class="pricing-section__cta">
        <a href="#formularz" class="btn btn--primary btn--lg" data-cta-click data-cta-location="pricing">Zapytaj o wycenę</a>
      </div>
    </div>
  </section>

  <ServiceFaq items={faqItems} />

  <section id="formularz" class="form-section" aria-label="Formularz wyceny">
    <div class="container">
      <SectionHeading title="Powiedz nam, co trzeba przewieźć" description="Opisz zakres przeprowadzki - odezwiemy się z wyceną i propozycją terminu." />
      <div class="form-section__grid">
        <div class="form-section__phone-card">
          <h3>Szybsza ścieżka</h3>
          <a href={`tel:${site.phoneRaw}`} data-cta-click data-cta-location="form-section">{site.phone}</a>
          <p class="form-section__phone-note">Jeżeli nie możemy odebrać od razu, wracamy z kontaktem zwykle w ciągu 1-2 godzin w godzinach pracy. Wiadomości wieczorne obsługujemy rano.</p>
        </div>
        <LeadForm
          formId="przeprowadzki-form"
          serviceType="Przeprowadzka mieszkania lub domu"
          variant="przeprowadzka"
          presentation="page"
          context="consumer"
          formLocation="przeprowadzki"
          heading="Powiedz nam, co trzeba przewieźć"
          intro="Opisz zakres przeprowadzki - odezwiemy się z wyceną i propozycją terminu."
          placeholder="Ile jest pomieszczeń? Jakie meble? Czy są rzeczy wymagające szczególnej ochrony?"
          submitLabel="Wyślij zapytanie"
        />
      </div>
    </div>
  </section>

  <FinalCta
    heading="Wolisz porozmawiać?"
    text="Zadzwoń - odpowiemy na pytania i umówimy oględziny."
  />

  <MobileStickyCta />
</Layout>

<style>
  .how-it-works-section {
    padding: var(--space-16) 0;
    background: var(--color-bg-white);
  }

  .how-it-works-section__intro {
    max-width: 48rem;
    margin: var(--space-4) auto var(--space-10);
    text-align: center;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .how-it-works-section__grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .how-it-works-section__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .how-it-works-section__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .how-it-works-section__card {
    padding: var(--space-6);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
  }

  .how-it-works-section__card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .how-it-works-section__card p {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .perspective-section {
    padding: var(--space-16) 0;
    background: var(--color-bg);
  }

  .perspective-section__content {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-8);
    max-width: 48rem;
    margin-inline: auto;
  }

  .perspective-section__item h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .perspective-section__item p {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .pricing-section {
    padding: var(--space-16) 0;
    background: var(--color-bg-white);
  }

  .pricing-section__text {
    max-width: 48rem;
    margin: var(--space-4) auto var(--space-8);
    text-align: center;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .pricing-section__cta {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
</style>
