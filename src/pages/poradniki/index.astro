---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import SafeImage from '../../components/SafeImage.astro';
import { getRoute } from '../../data/routes';
import { getSeo } from '../../data/seo';
import { buildSchemaGraph } from '../../lib/schema';

const route = getRoute('/poradniki/');
const seo = getSeo('/poradniki/');
const schemaGraph = buildSchemaGraph({ slug: '/poradniki/', breadcrumbs: [{ name: 'Poradniki' }] });
const steps = [
  ['Kilka tygodni przed', 'Ustal zakres, zdecyduj co jedzie, co zostaje i co wymaga osobnego sposobu transportu. Zgłoś nam ciężkie i nietypowe przedmioty jak najwcześniej.'],
  ['Przed pakowaniem', 'Przygotuj materiały, oznaczenia pomieszczeń i listę elementów delikatnych albo nietypowych. Podziel rzeczy na kategorie: meble, sprzęt, dokumenty, delikatne, codzienne.'],
  ['Podczas pakowania', 'Nie przeciążaj kartonów, opisuj ich docelowe miejsce i oddziel rzeczy potrzebne od razu. Ciężkie rzeczy dziel na mniejsze opakowania.'],
  ['Dzień przed', 'Zabezpiecz dokumenty, klucze, leki i podręczny zestaw poza głównym ładunkiem. Przygotuj opis pięter, windy i dojścia dla zespołu.'],
  ['W dniu przeprowadzki', 'Zapewnij dostęp, miejsce dla samochodu i jedną osobę uprawnioną do podejmowania decyzji. Wskaż elementy szczególnie delikatne i potwierdź miejsce docelowe dla najważniejszych rzeczy.'],
];
const practicalTips = [
  ['Kiedy rozpocząć przygotowania', 'Im większe zlecenie, tym wcześniej warto zacząć. Przy większych przeprowadzkach możliwe są bezpłatne oględziny - umów je z wyprzedzeniem.'],
  ['Jak opisać piętra, windy i dojście', 'Podaj numer piętra, czy jest winda, jej wymiary, szerokość klatki schodowej, zakręty i możliwość podjazdu samochodu pod budynek. Zdjęcia pomagają.'],
  ['Jak przygotować zdjęcia do wstępnej oceny', 'Sfotografuj przedmioty wymagające szczególnej uwagi, wąskie schody, zakręty i drzwi. Przy ciężkich gabarytach uwzględnij wymiary i wagę, jeśli znasz.'],
  ['Kiedy potrzebne są oględziny', 'Przy większych lub bardziej złożonych projektach - na przykład relokacja instytucji, transport pianina lub przeprowadzka z magazynowaniem pomostowym.'],
  ['Co warto przewieźć osobiście', 'Dokumenty, biżuterię, leki, klucze, sprzęt elektroniczny z danymi oraz rzeczy o wartości sentymentalnej. Te przedmioty bezpieczniej zabrać samodzielnie.'],
  ['Które przedmioty wymagają wcześniejszego zgłoszenia', 'Pianina, sejfy, piece, duże AGD, serwery i wyposażenie laboratoryjne. Każdy nietypowy gabaryt oceniamy przed realizacją - wymiar, masa i droga transportowa mają znaczenie.'],
];
---

<Layout seo={seo} schemaGraph={schemaGraph}>
  <ServiceHero eyebrow="Poradniki WHM" heading="Poradniki" lead="Praktyczne wskazówki, które ułatwią Ci przygotowanie do przeprowadzki." breadcrumbs={[{ label: route.name }]} heroImage="/images/guides/poradnik-jak-przygotowac-sie-do-przeprowadzki.webp" heroAlt="Materiały przygotowane do planowania i pakowania przeprowadzki" secondaryCtaLabel="Zapytaj o pakowanie" secondaryCtaHref="/pakowanie-i-zabezpieczanie/" />
  <section class="section section--alt"><div class="container"><SectionHeading label="Plan przygotowań" title="Pięć momentów, które warto zaplanować" /><div class="standard-steps">{steps.map(([title, desc], index) => <article class="standard-step"><span class="standard-step__number">{String(index + 1).padStart(2, '0')}</span><div><h2 class="standard-step__title">{title}</h2><p class="standard-step__desc">{desc}</p></div></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="split-section"><div class="split-section__content"><SectionHeading label="Najczęstszy błąd" title="Kartony bez oznaczeń przenoszą chaos do nowej lokalizacji" description="Na każdym kartonie zapisz pomieszczenie docelowe i krótki opis zawartości. Elementy delikatne oznacz wyraźnie, a rzeczy potrzebne pierwszego dnia trzymaj osobno." /><div class="section-cta"><a href="/pakowanie-i-zabezpieczanie/" class="arrow-link">Zobacz usługę pakowania i zabezpieczania</a></div></div><div class="split-section__media"><SafeImage src="/images/moving-boxes/kartony-do-przeprowadzki-1.webp" alt="Kartony i materiały używane przez WHM do przeprowadzki" loading="lazy" decoding="async" class="section-img" displayMode="section" /></div></div></div></section>
  <section class="section section--alt"><div class="container"><SectionHeading label="Praktyczne wskazówki" title="Co warto wiedzieć przed rozmową z zespołem" /><div class="standard-steps">{practicalTips.map(([title, desc], index) => <article class="standard-step"><span class="standard-step__number">{String(index + 1).padStart(2, '0')}</span><div><h2 class="standard-step__title">{title}</h2><p class="standard-step__desc">{desc}</p></div></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="split-section split-section--reverse"><div class="split-section__content"><SectionHeading label="Materiał dodatkowy" title="Pobierz poradnik PDF" description="Praktyczny poradnik w formacie PDF pomoże Ci zaplanować przygotowania do przeprowadzki krok po kroku." /><div class="section-cta"><a href="/guides/Przeprowadzka_bez_chaosu.pdf" class="btn btn--primary" data-cta-click data-cta-location="poradniki-pdf">Pobierz PDF</a></div></div><div class="split-section__media"><SafeImage src="/images/guides/poradnik-jak-przygotowac-sie-do-przeprowadzki.webp" alt="Okładka poradnika WHM o przygotowaniu do przeprowadzki" loading="lazy" decoding="async" class="section-img" displayMode="section" /></div></div></div></section>
  <section class="final-cta"><div class="container"><div class="final-cta__inner"><h2 class="final-cta__heading">Masz pytania o przygotowania?</h2><p class="final-cta__text">Zadzwoń lub opisz zlecenie - pomóżemy zaplanować zakres i termin.</p><div class="final-cta__actions"><a href="/kontakt/#formularz" class="btn btn--primary btn--lg" data-cta-click data-cta-location="poradniki-final">Opisz zlecenie</a><a href="/przeprowadzki/" class="btn btn--secondary btn--lg" data-cta-click data-cta-location="poradniki-final">Zobacz przeprowadzki</a></div></div></div></section>
  <MobileStickyCta formHref="/kontakt/#formularz" />
</Layout>
