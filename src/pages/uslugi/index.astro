---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import SafeImage from '../../components/SafeImage.astro';
import { getRoute, serviceNavigation } from '../../data/routes';
import { getSeo } from '../../data/seo';
import { buildSchemaGraph } from '../../lib/schema';

const route = getRoute('/uslugi/');
const cards = [
  { slug: '/przeprowadzki/', image: '/images/home-moving/przeprowadzki-domow-kielce-3.webp', text: 'Mieszkania i domy: plan, pakowanie, zabezpieczenie, transport oraz uzgodniony montaż.' },
  { slug: '/transport-mebli-kielce/', image: '/images/transport-mebli/transport-mebli-kielce-1.webp', text: 'Pojedyncze meble i zestawy z wyniesieniem, wniesieniem oraz ochroną podczas transportu.' },
  { slug: '/pakowanie-i-zabezpieczanie/', image: '/images/packing-services/pakowanie-przeprowadzki-kielce-3.webp', text: 'Pełne lub częściowe pakowanie z materiałami i oznaczeniem mienia.' },
  { slug: '/transport-pianin-i-fortepianow-kielce/', image: '/images/transport-pianin-i-fortepianow/transport-pianin-i-fortepianow-kielce-3.webp', text: 'Transport instrumentów po wcześniejszej ocenie trasy i warunków.' },
  { slug: '/transport-specjalistyczny/', image: '/images/transport-gabarytow/transport-gabarytow-kielce-7.webp', text: 'Ciężkie i nietypowe elementy wymagające indywidualnej technologii pracy.' },
  { slug: '/oproznianie-mieszkan-i-wywoz-mebli/', image: '/images/furniture-assembly/montaz-demontaz-mebli-1.webp', text: 'Wyniesienie i wywóz starych mebli oraz wyposażenia do PSZOK, z jasnym zakresem wyłączeń.' },
];
const cardData = cards.map((card) => ({ ...card, route: serviceNavigation.find((item) => item.slug === card.slug)! }));
const seo = getSeo('/uslugi/');
const schemaGraph = buildSchemaGraph({
  slug: '/uslugi/',
  breadcrumbs: [{ name: 'Usługi' }],
  itemList: cardData.map((card) => ({ name: card.route.name, url: `https://przeprowadzkikielce.pl${card.slug}` })),
});
---

<Layout seo={seo} schemaGraph={schemaGraph}>
  <ServiceHero eyebrow="Usługi WHM" heading="Przeprowadzka i transport dopasowane do jednej rzeczywistej potrzeby" lead="Zamiast mnożyć podobne podstrony, porządkujemy ofertę w sześć czytelnych ścieżek. Jeśli zakres łączy kilka usług, koordynujemy je jako jeden proces." breadcrumbs={[{ label: route.name }]} heroImage="/images/kielce-moving/przeprowadzki-kielce-1.webp" heroAlt="Samochód i zespół WHM podczas realizacji przeprowadzki" secondaryCtaLabel="Przejdź do wyceny" secondaryCtaHref="/kontakt/#formularz" />
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Oferta B2C" title="Wybierz zakres, który najlepiej opisuje zadanie" />
      <div class="services-grid services-grid--3col">
        {cardData.map((card) => <a class="service-card" href={card.slug}><div class="service-card__media"><SafeImage src={card.image} alt="" role="presentation" loading="lazy" decoding="async" /></div><div class="service-card__body"><h2 class="service-card__title">{card.route.name}</h2><p class="service-card__desc">{card.text}</p><span class="service-card__link">Poznaj zakres</span></div></a>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container"><div class="split-section"><div class="split-section__content"><SectionHeading label="Firmy i instytucje" title="Relokacje wymagające planu, etapów i ciągłości działania" description="Dla organizacji przygotowaliśmy osobną ścieżkę obejmującą bezpłatne oględziny, harmonogram, archiwa, sprzęt specjalistyczny i magazynowanie pomostowe." /><div class="section-cta"><a href="/dla-firm/" class="btn btn--primary" data-cta-click data-cta-location="services-b2b">Przejdź do oferty B2B</a></div></div><div class="split-section__media"><SafeImage src="/images/institution-moving/przeprowadzki-instytucji-4.webp" alt="Zespół WHM podczas relokacji instytucji" loading="lazy" decoding="async" class="section-img" displayMode="section" /></div></div></div>
  </section>
  <MobileStickyCta formHref="/kontakt/#formularz" />
</Layout>
