---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import SafeImage from '../../components/SafeImage.astro';
import { site } from '../../data/site';
import { pianinaPage as page } from '../../data/services';
import { getSeo } from '../../data/seo';
import { buildSchemaGraph, buildFaqSchema } from '../../lib/schema';

const seo = getSeo('/transport-pianin-i-fortepianow-kielce/');
const schemaGraph = buildSchemaGraph({ slug: '/transport-pianin-i-fortepianow-kielce/', breadcrumbs: [{ name: 'Usługi', url: 'https://przeprowadzkikielce.pl/uslugi/' }, { name: 'Transport pianin i fortepianów' }] });
const faqSchema = buildFaqSchema(page.faq.map((q) => ({ question: q.question, answer: q.answer })));
---

<Layout seo={seo} schemaGraph={schemaGraph} faqSchema={faqSchema}>

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
    ctaLabel={`Zadzwoń: ${site.phone}`}
    ctaHref={`tel:${site.phoneRaw}`}
    ctaSecondaryLabel="Opisz transport"
    ctaSecondaryHref="#formularz"
    heroImage={page.hero.image}
  />

  <!-- WHY -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.why.eyebrow} title={page.why.heading} />
      <ul class="simple-list">
        {page.why.items.map((item) => (
          <li class="simple-list__item">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CLIENT INFO -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.clientInfo.eyebrow} title={page.clientInfo.heading} />
      <ul class="simple-list">
        {page.clientInfo.items.map((item) => (
          <li class="simple-list__item">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROTECTION -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.protection.eyebrow} title={page.protection.heading} description={page.protection.text} />
    </div>
  </section>

  <!-- PHOTOS -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.photos.eyebrow} title={page.photos.heading} />
      <div class="photo-grid photo-grid--3">
        {page.photos.items.map((photo) => (
          <div class="photo-grid__item">
            <SafeImage src={photo.src} alt={photo.alt} loading="lazy" decoding="async" displayMode="natural" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STAIRS -->
  <section class="section section--alt">
    <div class="container">
      <div class="info-block">
        <SectionHeading label={page.stairs.eyebrow} title={page.stairs.heading} />
        <p class="info-block__text">{page.stairs.text}</p>
      </div>
    </div>
  </section>

  <!-- NOT INCLUDED -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.notIncluded.eyebrow} title={page.notIncluded.heading} />
      <ul class="simple-list">
        {page.notIncluded.items.map((item) => (
          <li class="simple-list__item">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="formularz" class="form-section" aria-label="Formularz wyceny transportu instrumentu">
    <div class="container">
      <SectionHeading title="Opisz instrument i drogę transportu" description="Podaj typ instrumentu, lokalizacje, piętra i dostęp do budynków. Zdjęcia możesz dosłać po zgłoszeniu." />
      <div class="form-section__grid">
        <div class="form-section__phone-card">
          <p class="section-heading__label">Ocena przed realizacją</p>
          <h3>Zadzwoń i opisz warunki</h3>
          <a href={`tel:${site.phoneRaw}`} data-cta-click data-cta-location="piano-form">{site.phone}</a>
          <p class="form-section__phone-note">Najpierw oceniamy instrument, trasę przenoszenia i potrzebne zabezpieczenia.</p>
        </div>
        <LeadForm formId="piano-service-form" serviceType="Transport pianina lub fortepianu" presentation="page" context="consumer" formLocation="/transport-pianin-i-fortepianow-kielce/" placeholder="Jaki instrument i jakie warunki dostępu?" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Najczęstsze pytania" title="Odpowiedzi na pytania o transport pianin i fortepianów" />
      <div class="faq-list">
        {page.faq.map((item) => (
          <details class="faq-item">
            <summary class="faq-item__question">{item.question}</summary>
            <div class="faq-item__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">{page.finalCta.heading}</h2>
        <p class="final-cta__text">{page.finalCta.text}</p>
        <div class="final-cta__actions">
          <a href="/kontakt/#formularz" class="btn btn--primary btn--lg" data-cta-click data-cta-location="piano-final">{page.finalCta.ctaLabel}</a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn--secondary btn--lg">Zadzwoń: 720 719 022</a>
        </div>
        <p class="final-cta__hours">Pn–Pt: {site.hours.weekdays} &middot; Sob: {site.hours.saturday}</p>
      </div>
    </div>
  </section>

  <!-- BACK LINK -->
  <section class="section--sm">
    <div class="container">
      <a href="/transport-specjalistyczny/" class="back-link">Transport specjalistyczny</a>
    </div>
  </section>
  <MobileStickyCta />
</Layout>
