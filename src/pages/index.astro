---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MobileStickyCta from '../components/MobileStickyCta.astro';
import SafeImage from '../components/SafeImage.astro';
import { site } from '../data/site';
import { getSeo } from '../data/seo';
import { buildSchemaGraph, buildFaqSchema } from '../lib/schema';
import {
  hero,
  trustFacts,
  introSection,
  servicesSection,
  standardSection,
  b2bSection,
  featuredRealizations,
  specialTransportSection,
  testimonials,
  ecosystemSection,
  processSection,
  guideSection,
  faqItems,
  serviceLinks,
  finalCta,
} from '../data/home';
---

<Layout
  seo={getSeo('/')}
  schemaGraph={buildSchemaGraph({ slug: '/' })}
  faqSchema={buildFaqSchema(faqItems)}
>
  <link slot="head" rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" href="/fonts/manrope-latin-ext.woff2" as="font" type="font/woff2" crossorigin />

  <!-- 1. HERO -->
  <section class="hero hero--single">
    <div class="hero__bg">
      <SafeImage
        src={hero.image}
        alt={hero.imageAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero__img"
        displayMode="hero"
      />
      <div class="hero__overlay"></div>
    </div>
    <div class="container">
      <div class="hero__content">
        <p class="hero__eyebrow">{hero.eyebrow}</p>
        <h1 class="hero__heading">{hero.heading}</h1>
        <p class="hero__lead">{hero.lead}</p>
        <div class="hero__actions">
          <a href={`tel:${site.phoneRaw}`} class="btn btn--primary btn--lg" data-cta-click data-cta-location="home-hero">Zadzwoń: {site.phone}</a>
          <a href="/kontakt/#formularz" class="btn btn--hero-secondary btn--lg" data-cta-click data-cta-location="home-hero">Zapytaj o wycenę</a>
        </div>
        <p class="hero__note">{hero.contactNote}</p>
      </div>
    </div>
  </section>

  <!-- 2. TRUST BAR -->
  <section class="trust-strip">
    <div class="container">
      <div class="trust-strip__grid">
        {trustFacts.map((fact) => (
          <div class="trust-strip__item">
            <p class="trust-strip__title">{fact.title}</p>
            <p class="trust-strip__desc">{fact.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. SERVICES -->
  <section class="section">
    <div class="container">
      <SectionHeading
        label={servicesSection.eyebrow}
        title={servicesSection.heading}
        description={servicesSection.intro}
      />
      <div class="services-grid">
        {servicesSection.items.map((item) => (
          <a href={item.href} class="service-card">
            <div class="service-card__media">
              <SafeImage
                src={item.image}
                alt={item.title}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="service-card__body">
              <h3 class="service-card__title">{item.title}</h3>
              <p class="service-card__desc">{item.desc}</p>
              <span class="service-card__link">Poznaj usługę</span>
            </div>
          </a>
        ))}
      </div>
      <div class="section-cta section-cta--center">
        <a href={servicesSection.cta.href} class="arrow-link">{servicesSection.cta.label}</a>
      </div>
    </div>
  </section>

  <!-- 4. TESTIMONIALS -->
  {testimonials.length > 0 && (
    <section class="section section--alt testimonials-static">
      <div class="container">
        <SectionHeading label="Opinie klientów" title="Spokojna przeprowadzka zaczyna się od zaufania" description="Klienci opisują nie tylko transport, ale też sposób, w jaki zajmujemy się nimi i ich rzeczami." />
        <div class="testimonials-static__grid">
          {testimonials.map((t) => (
            <div class="testimonial-static">
              <blockquote class="testimonial-static__text">{t.text}</blockquote>
              <p class="testimonial-static__author">
                {t.author}
                {t.source && <span class="testimonial-static__source"> · {t.source}</span>}
              </p>
            </div>
          ))}
        </div>
        <div class="section-cta section-cta--center" style="margin-top: var(--space-6);">
          <a href="https://maps.app.goo.gl/G3BqHNabtfWtzAhk7" target="_blank" rel="noopener noreferrer" class="arrow-link">
            Zobacz opinie w Google
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- 5. INTRO / HOW WE HELP -->
  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content">
          <SectionHeading
            label={introSection.eyebrow}
            title={introSection.heading}
            description={introSection.text}
          />
          <ul class="check-list">
            {introSection.points.map((point) => (
              <li class="check-list__item">{point}</li>
            ))}
          </ul>
          <div class="section-cta">
            <a href={introSection.cta.href} class="arrow-link">{introSection.cta.label}</a>
          </div>
        </div>
        <div class="split-section__media">
          <SafeImage
            src={introSection.image}
            alt="Pracownik WHM zabezpiecza wyposażenie do transportu"
            loading="lazy"
            decoding="async"
            class="section-img"
            displayMode="section"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. STANDARD WHM -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        label={standardSection.eyebrow}
        title={standardSection.heading}
        description={standardSection.text}
      />
      <div class="equipment-grid">
        {standardSection.equipmentModules.map((mod) => (
          <div class="equipment-card">
            <div class="equipment-card__media">
              <SafeImage src={mod.image} alt={mod.name} loading="lazy" decoding="async" />
            </div>
            <div class="equipment-card__body">
              <h3 class="equipment-card__name">{mod.name}</h3>
              <p class="equipment-card__benefit">{mod.benefit}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="section-cta section-cta--center">
        <a href={standardSection.cta.href} class="arrow-link">{standardSection.cta.label}</a>
      </div>
    </div>
  </section>

  <!-- 7. B2B -->
  <section class="section">
    <div class="container">
      <div class="split-section split-section--reverse">
        <div class="split-section__content">
          <SectionHeading label={b2bSection.eyebrow} title={b2bSection.heading} description={b2bSection.text} />
          <ul class="check-list">
            {b2bSection.points.map((point) => (
              <li class="check-list__item">{point}</li>
            ))}
          </ul>
          <div class="section-cta"><a href={b2bSection.cta.href} class="btn btn--primary" data-cta-click data-cta-location="home-b2b">{b2bSection.cta.label}</a></div>
        </div>
        <div class="split-section__media"><SafeImage src={b2bSection.image} alt="Zespół WHM podczas relokacji instytucji" loading="lazy" decoding="async" class="section-img" displayMode="section" /></div>
      </div>
    </div>
  </section>

  <!-- 8. FEATURED REALIZATIONS -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        label="Realizacje"
        title="Za naszym doświadczeniem stoją konkretne realizacje"
        description="Od przeprowadzek domowych po instytucje, w których znaczenie ma każdy etap. Zobacz, jakie zadania powierzono WHM i jak je wykonaliśmy."
      />
      <div class="featured-realizations">
        {featuredRealizations.map((real) => (
          <a class="featured-realization" href={real.href}>
            <div class="featured-realization__media">
              <SafeImage src={real.image} alt={real.title} loading="lazy" decoding="async" />
            </div>
            <div class="featured-realization__body">
              <span class="featured-realization__label">{real.label}</span>
              <h3 class="featured-realization__title">{real.title}</h3>
              <p class="featured-realization__location">{real.location}</p>
              <ul class="featured-realization__params">
                {real.params.map((param) => <li>{param}</li>)}
              </ul>
              <p class="featured-realization__desc">{real.desc}</p>
              <span class="arrow-link">Zobacz realizację</span>
            </div>
          </a>
        ))}
      </div>
      <div class="section-cta section-cta--center">
        <a href="/realizacje/" class="arrow-link">Poznaj pozostałe realizacje</a>
      </div>
    </div>
  </section>

  <!-- 9. SPECIAL TRANSPORT -->
  <section class="section">
    <div class="container">
      <SectionHeading
        label={specialTransportSection.eyebrow}
        title={specialTransportSection.heading}
        description={specialTransportSection.text}
      />
      <ul class="tag-list">
        {specialTransportSection.categories.map((cat) => (
          <li class="tag-list__item">{cat}</li>
        ))}
      </ul>
      <div class="section-cta" style="display: flex; flex-wrap: wrap; gap: var(--space-4);">
        <a href={specialTransportSection.cta.href} class="btn btn--primary" data-cta-click data-cta-location="home-special-transport">{specialTransportSection.cta.label}</a>
        <a href={specialTransportSection.ctaSecondary.href} class="btn btn--secondary" data-cta-click data-cta-location="home-special-transport">{specialTransportSection.ctaSecondary.label}</a>
      </div>
      <div class="image-row">
        <SafeImage
          src={specialTransportSection.images[0]}
          alt="Wykorzystanie schodołazu przy transporcie ciężkiego ładunku"
          loading="lazy"
          decoding="async"
          class="section-img"
          displayMode="section"
        />
        <SafeImage
          src={specialTransportSection.images[1]}
          alt="Transport instrumentu muzycznego przez zespół WHM"
          loading="lazy"
          decoding="async"
          class="section-img"
          displayMode="section"
        />
        <SafeImage
          src={specialTransportSection.images[2]}
          alt="Praca z dużym wyposażeniem biurowym"
          loading="lazy"
          decoding="async"
          class="section-img"
          displayMode="section"
        />
      </div>
    </div>
  </section>

  <!-- 10. ECOSYSTEM -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        label={ecosystemSection.eyebrow}
        title={ecosystemSection.heading}
      />
      <div class="ecosystem-grid">
        <div class="ecosystem-card ecosystem-card--storage">
          <div class="ecosystem-card__media">
            <SafeImage
              src={ecosystemSection.storage.image}
              alt="Ogrzewany i zabezpieczony magazyn WHM w Masłowie koło Kielc"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="ecosystem-card__body">
            <h3>{ecosystemSection.storage.title}</h3>
            <p>{ecosystemSection.storage.text}</p>
            <div class="section-cta">
              <a href={ecosystemSection.storage.cta.href} class="arrow-link">{ecosystemSection.storage.cta.label}</a>
            </div>
          </div>
        </div>
        <div class="ecosystem-card">
          <div class="ecosystem-card__media">
            <SafeImage
              src={ecosystemSection.shop.image}
              alt="Zapas kartonów i materiałów do przeprowadzki w WHM Shop"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="ecosystem-card__body">
            <h3>{ecosystemSection.shop.title}</h3>
            <p>{ecosystemSection.shop.text}</p>
            <div class="section-cta">
              <a href={ecosystemSection.shop.cta.href} class="arrow-link">{ecosystemSection.shop.cta.label}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. PROCESS -->
  <section class="section">
    <div class="container">
      <SectionHeading
        label={processSection.eyebrow}
        title={processSection.heading}
      />
      <div class="process-steps">
        {processSection.steps.map((step) => (
          <div class="process-step">
            <span class="process-step__number">{step.number}</span>
            <div>
              <p class="process-step__title">{step.title}</p>
              <p class="process-step__desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="section-cta section-cta--center">
        <a href={processSection.cta.href} class="arrow-link">{processSection.cta.label}</a>
      </div>
    </div>
  </section>

  <!-- 12. GUIDE -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content">
          <SectionHeading
            label={guideSection.eyebrow}
            title={guideSection.heading}
            description={guideSection.text}
          />
          <div class="section-cta">
            <a href={guideSection.cta.href} class="arrow-link">{guideSection.cta.label}</a>
          </div>
        </div>
        <div class="split-section__media">
          <SafeImage
            src={guideSection.image}
            alt="Poradnik przygotowania do przeprowadzki WHM"
            loading="lazy"
            decoding="async"
            class="section-img"
            displayMode="section"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 13. FAQ -->
  <section class="section">
    <div class="container">
      <SectionHeading
        label="Najczęstsze pytania"
        title="Odpowiedzi na pytania, które słyszymy najczęściej"
      />
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary class="faq-item__question">{item.question}</summary>
            <div class="faq-item__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 14. SERVICE LINKS -->
  <section class="section section--sm">
    <div class="container">
      <SectionHeading label="Usługi" title="Znajdź usługę dla siebie" tag="p" />
      <div class="related-links">
        {serviceLinks.map((link) => (
          <a href={link.href} class="arrow-link">{link.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- 15. FINAL CTA -->
  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">{finalCta.heading}</h2>
        <p class="final-cta__text">{finalCta.text}</p>
        <div class="final-cta__actions">
          <a href={`tel:${site.phoneRaw}`} class="btn btn--primary btn--lg" data-cta-click data-cta-location="home-final">Zadzwoń: {site.phone}</a>
          <a href="/kontakt/#formularz" class="btn btn--secondary btn--lg" data-cta-click data-cta-location="home-final">Zapytaj o wycenę</a>
          <a href={`sms:${site.phoneRaw}`} class="btn btn--secondary btn--lg" data-cta-click data-cta-location="home-final">Wyślij SMS</a>
        </div>
        <p class="final-cta__hours">
          Pn-Pt: {site.hours.weekdays} · Sob: {site.hours.saturday}
        </p>
      </div>
    </div>
  </section>
  <MobileStickyCta formHref="/kontakt/#formularz" />
</Layout>
