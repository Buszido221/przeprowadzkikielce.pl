---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import GtmHead from '../components/GtmHead.astro';
import CampaignAttribution from '../components/CampaignAttribution.astro';
import ClientEvents from '../components/ClientEvents.astro';
import { site } from '../data/site';
import { isStaging } from '../lib/environment';
import { publicAssetExists } from '../lib/public-assets';
import { getImageAsset } from '../data/imageManifest';
import type { SeoPage } from '../data/seo';
import { getCanonicalUrl } from '../data/seo';
import '../styles/base.css';
import '../styles/main.css';

interface Props {
  seo: SeoPage;
  schemaGraph?: object;
  faqSchema?: object;
}

const { seo, schemaGraph, faqSchema } = Astro.props;

const canonicalUrl = getCanonicalUrl(seo.slug);
const robotsContent = isStaging ? 'noindex, nofollow, noarchive' : seo.robots;

const ogImage = seo.ogImage;
const hasOgImage = ogImage ? publicAssetExists(ogImage) : false;
const ogImageUrl = ogImage ? new URL(ogImage, site.domain).href : undefined;
const ogAsset = ogImage ? getImageAsset(ogImage) : undefined;
const ogImageWidth = ogAsset?.width;
const ogImageHeight = ogAsset?.height;
const ogImageAlt = seo.ogImageAlt ?? '';
const ogImageType = ogImage?.endsWith('.webp') ? 'image/webp' : ogImage?.endsWith('.png') ? 'image/png' : 'image/jpeg';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robotsContent} />
    <meta name="description" content={seo.description} />
    <link rel="icon" type="image/svg+xml" href="/LOGO_WHM.svg" />
    {seo.hasCanonical && <link rel="canonical" href={canonicalUrl} />}
    <title>{seo.title}</title>

    <meta property="og:type" content={seo.ogType} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    {hasOgImage && ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {hasOgImage && ogImageUrl && <meta property="og:image:secure_url" content={ogImageUrl} />}
    {hasOgImage && ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {hasOgImage && ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    {hasOgImage && <meta property="og:image:type" content={ogImageType} />}
    {hasOgImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content={hasOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {hasOgImage && ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {hasOgImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <meta name="theme-color" content="#1a1a1a" />

    <GtmHead />
    <CampaignAttribution />
    <ClientEvents />
    {schemaGraph && <script slot="head" type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />}
    {faqSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Przejdź do treści</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {isStaging ? null : <Analytics />}
  </body>
</html>
