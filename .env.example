# EmailJS configuration (for contact form)
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Tag Manager (replaces direct GA4)
PUBLIC_GTM_ID=

# Site environment: "production" or "staging"
# Production: index, follow on all public pages (staging: noindex, nofollow, noarchive)
PUBLIC_SITE_ENV=production
